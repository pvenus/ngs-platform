def digest(raw):
    return hashlib.sha256(raw).hexdigest()


def private(path, directory=False):
    s = path.lstat()
    require(path.resolve() == path and s.st_uid == os.getuid()
            and (stat.S_ISDIR(s.st_mode) if directory else stat.S_ISREG(s.st_mode))
            and stat.S_IMODE(s.st_mode) == (0o700 if directory else 0o600),
            "PRIVATE_RELEASE_REQUIRED")
    return path


def sync_directory(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atom(path, data, create=False):
    fd, temp = tempfile.mkstemp(prefix=".deploy-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as out:
            out.write(data)
            out.flush()
            os.fsync(out.fileno())
        if create:
            os.link(temp, path)  # O_EXCL semantics
        else:
            os.replace(temp, path)
        sync_directory(path.parent)
    finally:
        try:
            os.unlink(temp)
        except FileNotFoundError:
            pass


def tree_sha(root):
    rows = []
    for p in sorted(root.rglob("*")):
        s = p.lstat()
        require(s.st_uid == os.getuid(), "RELEASE_TREE_OWNER_DRIFT")
        if stat.S_ISLNK(s.st_mode):
            require(p.is_relative_to(root / "local-miniflare/node_modules")
                    and p.resolve(strict=True).is_relative_to(root / "local-miniflare/node_modules"),
                    "RELEASE_LINK_DRIFT")
            value = ["link", os.readlink(p)]
        elif stat.S_ISREG(s.st_mode):
            require(not s.st_mode & 0o022, "RELEASE_TREE_MODE_DRIFT")
            with p.open("rb") as handle:
                value = ["file", stat.S_IMODE(s.st_mode), hashlib.file_digest(handle, "sha256").hexdigest()]
        else:
            require(stat.S_ISDIR(s.st_mode) and not s.st_mode & 0o022, "RELEASE_TREE_MODE_DRIFT")
            value = ["directory", stat.S_IMODE(s.st_mode)]
        rows.append([p.relative_to(root).as_posix(), value])
    return digest(json.dumps(rows, separators=(",", ":"), ensure_ascii=True).encode())


def load_plan(sha, control, releases, scratch):
    require(isinstance(sha, str) and SHA.fullmatch(sha), "INVALID_RELEASE_SHA")
    private(control, True)
    ops = json.loads(private(control / "prepared.json").read_bytes())
    require(ops.get("schemaVersion") == "ops.ngs-prepared-deploy.v1" and ops.get("sha") == sha
            and ops.get("mac") == {"ready": True}, "OPS_RELEASE_NOT_PREPARED")
    prov = ops.get("provenance")
    require(type(prov) is dict and set(prov) == {"runId", "runAttempt", "artifactId", "archiveSha256"}
            and all(type(prov[k]) is str and ID.fullmatch(prov[k]) for k in ("runId", "runAttempt", "artifactId"))
            and type(prov["archiveSha256"]) is str and DIGEST.fullmatch(prov["archiveSha256"]),
            "OPS_PROVENANCE_INVALID")
    private(control / "mac-releases", True)
    folder = private(control / "mac-releases" / sha, True)
    spec = json.loads(private(folder / "manifest.json").read_bytes())
    require(set(spec) == {"schemaVersion", "sha", "repo", "ref", "workflow", "archiveSha256",
                           "treeSha256", "expectedPriorPlistSha256"}
            and spec["schemaVersion"] == "ops.ngs-mac-release.v1" and spec["sha"] == sha
            and spec["repo"] == REPO and spec["ref"] == BRANCH, "RELEASE_PROVENANCE_INVALID")
    wf = spec["workflow"]
    require(type(wf) is dict and wf == {"headSha": sha, "headBranch": "main", "conclusion": "success",
                                        "runId": prov["runId"], "runAttempt": prov["runAttempt"],
                                        "artifactId": prov["artifactId"]},
            "GITHUB_WORKFLOW_NOT_VERIFIED")
    require(all(isinstance(spec[k], str) and DIGEST.fullmatch(spec[k])
                for k in ("archiveSha256", "treeSha256", "expectedPriorPlistSha256")),
            "RELEASE_DIGEST_INVALID")
    require(prov["archiveSha256"] == spec["archiveSha256"], "RELEASE_ARCHIVE_DRIFT")
    selected = private(releases / ("project-page-github-" + sha), True)
    workdir = private(scratch / sha, True)
    deps = selected / "local-miniflare/node_modules"
    with private(folder / "ngs-local.tar").open("rb") as archive:
        require(hashlib.file_digest(archive, "sha256").hexdigest() == spec["archiveSha256"],
                "RELEASE_ARCHIVE_DRIFT")
        archive.seek(0)
        seen = set()
        with tarfile.open(fileobj=archive, mode="r|") as tar:
            for member in tar:
                name = Path(member.name)
                p = selected / name
                require(not name.is_absolute() and ".." not in name.parts and p.resolve() == p
                        and not p.is_relative_to(deps), "ARCHIVE_PATH_INVALID")
                if member.isdir():
                    require(p.is_dir(), "ARCHIVE_TREE_DRIFT")
                    continue
                require(member.isfile() and p.is_file() and p not in seen, "ARCHIVE_TREE_DRIFT")
                seen.add(p)
                with p.open("rb") as local, tar.extractfile(member) as source:
                    require(hashlib.file_digest(local, "sha256").digest()
                            == hashlib.file_digest(source, "sha256").digest(), "ARCHIVE_BLOB_DRIFT")
        require(seen == {p for p in selected.rglob("*")
                         if (p.is_file() or p.is_symlink()) and not p.is_relative_to(deps)},
                "ARCHIVE_TREE_DRIFT")
    require(tree_sha(selected) == spec["treeSha256"] and (selected / ENTRY).is_file()
            and (selected / "local-miniflare/package-lock.json").is_file(), "RELEASE_TREE_DRIFT")
    locked = json.loads((selected / "local-miniflare/package-lock.json").read_bytes())["packages"]
    require(all(name in locked for name in ("node_modules/miniflare", "node_modules/workerd")),
            "MINIFLARE_DEPENDENCIES_NOT_LOCKED")
    for name, entry in locked.items():
        if not name:
            continue
        package = selected / "local-miniflare" / name / "package.json"
        require(package.is_relative_to(deps) and package.resolve() == package, "MINIFLARE_LOCK_INVALID")
        if not package.exists() and entry.get("optional") is True:
            continue
        require(package.is_file() and json.loads(package.read_bytes())["version"] == entry["version"],
                "MINIFLARE_DEPENDENCIES_NOT_READY")
    return folder, spec, selected, workdir


def file_digest(path):
    if not path.exists() and not path.is_symlink():
        return None
    if path.resolve() != path or not path.is_file():
        raise Refused("STORAGE_STARTUP_INPUTS_CHANGED")
    return digest(path.read_bytes())


def audio_upgrade(old, release):
    """Recognize the single reviewed migration pair, not arbitrary startup drift."""
    watched = set(SCHEMA_INPUTS)
    pairs = {path: (file_digest(old / path), file_digest(release / path)) for path in watched}
    require(all(None not in pairs[path] for path in SCHEMA_INPUTS if path != AUDIO_SQL),
            "STORAGE_STARTUP_INPUTS_CHANGED")
    changes = {path: pair for path, pair in pairs.items() if pair[0] != pair[1]}
    if not changes:
        return False
    changes[AUDIO_CORE] = (file_digest(old / AUDIO_CORE), file_digest(release / AUDIO_CORE))
    require(changes == AUDIO_CHANGED
            and file_digest(old / SCHEMA_SQL[0]) == "ece870d0e6aae03efb748bc8823ace35b6465b1b7ed47907a9dfdb3473fe4117"
            and file_digest(old / SCHEMA_SQL[1]) == "0943cc2bc8d6abb4822df6c9e299b400bda65a931cf9e1245e8b61749f15a8f8"
            and file_digest(old / SCHEMA_INPUTS[-1]) == "67d588e052138372d72348439a67b0d8058a3462352f2e77258be16b525a9d88",
            "STORAGE_STARTUP_INPUTS_CHANGED")
    return True


def schema_rows(db):
    return db.execute("""SELECT type,name,tbl_name,sql FROM sqlite_schema
        WHERE name NOT GLOB 'sqlite_*' AND name<>'_cf_METADATA'
        ORDER BY type,name""").fetchall()


def audio_states(release):
    """Canonical exact DDL and pins from the already verified release archive."""
    sql = [(release / name).read_bytes() for name in SCHEMA_SQL]
    states = {}
    with sqlite3.connect(":memory:") as authority:
        authority.execute(SCHEMA_PIN)
        for i, part in enumerate(sql):
            authority.executescript(part.decode())
            if i >= 1:
                states[i + 14] = (digest(b"\0".join(sql[:i+1])), schema_rows(authority))
    return states


def confirm_audio_schema(db, states):
    pins = db.execute("SELECT id,sha256 FROM ngs_local_replica_schema_pin").fetchall()
    rows = schema_rows(db)
    for version, (pin, expected) in states.items():
        if pins == [(1, pin)] and rows == expected:
            return version
    raise Refused(AUDIO_SHA)


def audio_schema_transaction(path, states, *, undo=False):
    """Called only after native hold and the exact SQLite file identity are proven."""
    db = sqlite3.connect(path.as_uri()+"?mode=rw", uri=True, timeout=0, isolation_level=None)
    try:
        db.execute("PRAGMA trusted_schema=OFF")
        db.execute("BEGIN EXCLUSIVE")
        found = confirm_audio_schema(db, states)
        if undo and found == 16:
            db.execute("DROP TABLE ngs_audio_result_index_v1")
            db.execute("DROP TABLE ngs_audio_result_index_progress_v1")
            changed = db.execute("UPDATE ngs_local_replica_schema_pin SET sha256=? WHERE id=1 AND sha256=?",
                                 (states[15][0], states[16][0])).rowcount
            require(changed == 1, AUDIO_SHA)
            found = confirm_audio_schema(db, states)
        require(found == 15, AUDIO_SHA)
        db.execute("COMMIT")
    except Exception:
        if db.in_transaction:
            db.execute("ROLLBACK")
        raise
    finally:
        db.close()


def approve_audio_separation(folder, spec, release):
    marker = folder / AUDIO_OPT_IN
    if not present(marker):
        return False
    try:
        value = json.loads(private(marker).read_bytes(), object_pairs_hook=unique_json)
        valid = value == {"schemaVersion": "ops.ngs-local-audio-separation-enable.v1", "sha": spec["sha"],
                          "expectedPriorPlistSha256": spec["expectedPriorPlistSha256"], "archiveSha256": spec["archiveSha256"]}
        require(valid and file_digest(release / AUDIO_CORE) == AUDIO_CHANGED[AUDIO_CORE][1] and
                file_digest(release / AUDIO_SQL) == AUDIO_CHANGED[AUDIO_SQL][1],
                "NATIVE_AUDIO_SEPARATION_ATTESTATION_INVALID")
    except (OSError, ValueError, Refused):
        raise Refused("NATIVE_AUDIO_SEPARATION_ATTESTATION_INVALID") from None
    return True


def unique_json(pairs):
    value = dict(pairs)
    if len(value) != len(pairs):
        raise ValueError("duplicate")
    return value


def select(raw, release, workdir, releases, scratch, queue, sha, *, enable_audio_separation=False):
    plist = plistlib.loads(raw)
    args = plist["ProgramArguments"]
    env = plist["EnvironmentVariables"]
    require(plist["Label"] == LABEL and len(args) == 2 and Path(args[0]).is_absolute()
            and Path(args[0]).name == "node", "NATIVE_ROLE_DRIFT")
    old = Path(args[1]).parents[3]
    require(old.parent == releases and re.fullmatch(r"project-page-github-[0-9a-f]{7,40}", old.name)
            and Path(args[1]) == old / ENTRY and (old / ENTRY).is_file()
            and Path(plist["WorkingDirectory"]).parent == scratch,
            "NATIVE_ROLE_DRIFT")
    require(env.get("NGS_PROJECT_LISTEN_PORT") == "5274" and env.get("NGS_REQUEST_QUEUE_MCP_PORT") == "5275"
            and env.get("NGS_REQUEST_QUEUE_DB") == str(queue) and env.get("NGS_FILE_SYNC_MODE") == "push"
            and env.get("NGS_FILE_SYNC_PROJECTS") == "binari"
            and not {"NGS_LOCAL_S3_CONFIG", "NGS_LOCAL_REPLICA_DB"} & env.keys(), "NATIVE_ROLE_DRIFT")
    migrating = audio_upgrade(old, release)
    plist["ProgramArguments"] = [args[0], str(release / ENTRY)]
    plist["WorkingDirectory"] = str(workdir)
    require(SHA.fullmatch(sha) and release.name == "project-page-github-" + sha, "NATIVE_RELEASE_SHA_DRIFT")
    require(not enable_audio_separation or env.get("NGS_AUDIO_WORKSPACE_ENABLED") == "1",
            "NATIVE_AUDIO_SEPARATION_ATTESTATION_INVALID")
    flag = {"NGS_AUDIO_SEPARATION_ENABLED": "1"} if enable_audio_separation else {}
    plist["EnvironmentVariables"] = {**env, **flag, "NGS_COMMIT_SHA": sha}
    return old, plistlib.dumps(plist), env, migrating


class Mac:
    uid = os.getuid()
    plist = HOME / "Library/LaunchAgents" / f"{LABEL}.plist"
    legacy = HOME / "Library/LaunchAgents" / f"{LEGACY}.plist"
    releases = NGS / "code/releases"
    scratch = NGS / "runtime/local-miniflare-execution"
    queue = NGS / "data/local-request-queue/queue.sqlite"

    def run(self, *cmd):
        return subprocess.check_output(cmd, text=True, timeout=8, stderr=subprocess.DEVNULL)

    def unchanged(self, env):
        scope = Path(env["NGS_LOCAL_MINIFLARE_ROOT"])
        require(scope.parent == ROOT and scope.name.startswith("NGS-Miniflare-")
                and ROOT.is_mount(), "NATIVE_SSD_UNAVAILABLE")
        def pin(p):
            a = p.lstat()
            require(p.resolve() == p and a.st_uid == self.uid, "NATIVE_STATE_DRIFT")
            return (a.st_dev, a.st_ino)
        pins = [pin(p) for p in (scope, scope / "d1", scope / "r2", self.queue)]
        require(all(p[0] == ROOT.stat().st_dev for p in pins[:3]), "NATIVE_SSD_DRIFT")
        return pins

    def read_plist(self):
        require(not self.legacy.exists() and not self.legacy.is_symlink()
                and self.plist.resolve() == self.plist and self.plist.is_file()
                and self.plist.stat().st_uid == self.uid, "NATIVE_PLIST_DRIFT")
        return self.plist.read_bytes()

    def replace(self, expected, candidate):
        require(self.read_plist() == expected, "NATIVE_PLIST_DRIFT")
        atom(self.plist, candidate)

    def bootout(self):
        self.run("/bin/launchctl", "bootout", f"gui/{self.uid}/{LABEL}")

    def bootstrap(self):
        self.run("/bin/launchctl", "bootstrap", f"gui/{self.uid}", str(self.plist))

    def pid(self):
        try:
            info = self.run("/bin/launchctl", "print", f"gui/{self.uid}/{LABEL}")
        except subprocess.CalledProcessError:
            return None
        m = re.search(r"(?m)^\s*pid = ([0-9]+)\s*$", info)
        return int(m[1]) if m else None

    def stop_if_loaded(self):
        result = subprocess.run(["/bin/launchctl", "print", f"gui/{self.uid}/{LABEL}"],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8)
        if result.returncode == 0:
            self.bootout()

    def audio_db_file(self, env):
        root = private(Path(env["NGS_LOCAL_MINIFLARE_ROOT"]), True)
        path = root / D1_REL
        for parent in (path.parent.parent, path.parent):
            info = parent.lstat()
            require(parent.resolve() == parent and stat.S_ISDIR(info.st_mode)
                    and info.st_uid == self.uid and info.st_dev == root.stat().st_dev
                    and not info.st_mode & 0o022, AUDIO_SHA)
        def check(file):
            info = file.lstat()
            require(file.resolve() == file and stat.S_ISREG(info.st_mode) and info.st_uid == self.uid
                    and info.st_dev == root.stat().st_dev and info.st_nlink == 1
                    and not info.st_mode & 0o022, AUDIO_SHA)
            return info
        identity = check(path)
        for extension in ('-wal', '-shm', '-journal'):
            sidecar = path.with_name(path.name + extension)
            if present(sidecar):
                check(sidecar)
        return path, (identity.st_dev, identity.st_ino)

    def audio_service_status(self):
        result = subprocess.run(["/bin/launchctl", "print", f"gui/{self.uid}/{LABEL}"],
                                capture_output=True, text=True, timeout=8)
        if result.returncode == 0:
            return True
        message = result.stdout + result.stderr
        require(result.returncode == 113 and f'Could not find service "{LABEL}"' in message
                and f"user gui: {self.uid}" in message, AUDIO_HELD)
        return False

    def require_audio_hold(self, prior_pid, path):
        require(not self.audio_service_status() and not self.listener(5274) and not self.listener(5275), AUDIO_HELD)
        if prior_pid:
            gone = subprocess.run(["/bin/ps", "-p", str(prior_pid), "-o", "pid="],
                                  capture_output=True, text=True, timeout=8)
            require(gone.returncode == 1 and not (gone.stdout or gone.stderr), AUDIO_HELD)
        # An exited LaunchAgent and closed ports alone do not exclude an
        # orphaned Workerd holding a SQLite WAL handle.
        paths = [path, *(Path(str(path) + ext) for ext in ('-wal', '-shm', '-journal') if present(Path(str(path) + ext)))]
        owners = subprocess.run(["/usr/sbin/lsof", "-nP", "-Fp", "--", *map(str, paths)],
                                capture_output=True, text=True, timeout=8)
        require(owners.returncode == 1 and not (owners.stdout or owners.stderr), AUDIO_HELD)

    def audio_storage(self, env, pinned, prior_pid, states, *, undo=False, wait=20):
        end = time.monotonic() + wait
        while True:
            path, identity = self.audio_db_file(env)
            require((path, identity) == pinned, AUDIO_SHA)
            try:
                self.require_audio_hold(prior_pid, path)
                break
            except Refused:
                if time.monotonic() >= end:
                    raise
                time.sleep(0.25)
        audio_schema_transaction(path, states, undo=undo)
        require(self.audio_db_file(env) == pinned, AUDIO_SHA)

    def listener(self, port):
        try:
            out = self.run("/usr/sbin/lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-Fp")
        except subprocess.CalledProcessError as e:
            if e.returncode != 1:
                raise
            return set()
        return {int(p[1:]) for p in out.splitlines() if re.fullmatch(r"p[0-9]+", p)}

    @staticmethod
    def http(port, path, method="GET", headers=None, body=None):
        conn = http.client.HTTPConnection("127.0.0.1", port, timeout=2)
        try:
            conn.request(method, path, body=body, headers=headers or {})
            response = conn.getresponse()
            return response.status, response.getheader("Set-Cookie"), json.loads(response.read(256 * 1024))
        finally:
            conn.close()

    def rpc(self, method, params):
        status, _, doc = self.http(5275, "/mcp", "POST", {"Content-Type": "application/json"},
                                   json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}))
        require(status == 200 and doc.get("id") == 1 and "result" in doc, "NATIVE_MCP_UNAVAILABLE")
        return doc["result"]

    def healthy(self, release, old_pid=None, wait=35):
        end = time.monotonic() + wait
        last_explicit = None
        while True:
            try:
                pid = self.pid()
                require(pid and pid != old_pid and self.listener(5274) == self.listener(5275) == {pid},
                        "NATIVE_PORT_OWNER_DRIFT")
                command = self.run("/bin/ps", "-p", str(pid), "-o", "command=").strip()
                require(command.endswith(" " + str(release / ENTRY)), "NATIVE_PROCESS_PIN_DRIFT")
                status, cookie, session = self.http(5274, "/__npcgen_session")
                require(status == 200 and cookie and session.get("state") == "authenticated",
                        "NATIVE_AUTH_UNAVAILABLE")
                path = "/api/ngs-sync-progress?projectId=binari"
                require(self.http(5274, path)[0] == 401 and
                        self.http(5274, path, headers={"Cookie": cookie.split(";")[0]})[0] == 200,
                        "NATIVE_AUTH_SCOPE_DRIFT")
                require(self.http(5275, "/api/ngs-file-sync-file") ==
                        (405, None, {"error": "METHOD_NOT_ALLOWED"}), "NATIVE_RAW_ROUTE_UNAVAILABLE")
                require(TOOLS <= {v["name"] for v in self.rpc("tools/list", {})["tools"]},
                        "NATIVE_MCP_UNAVAILABLE")
                queue = self.rpc("tools/call", {"name": "ngs_request_queue_list", "arguments": {"limit": 1}})
                require(queue.get("isError") is False
                        and isinstance(queue["structuredContent"]["requests"], list), "NATIVE_QUEUE_UNAVAILABLE")
                return pid
            except (Refused, ValueError, OSError, KeyError, TypeError, subprocess.SubprocessError, http.client.HTTPException) as error:
                last_explicit = known_reason(error, HEALTH_CODES) or last_explicit
                if time.monotonic() >= end:
                    raise Refused(last_explicit or "NATIVE_HEALTH_UNVERIFIED") from None
                time.sleep(0.25)



def valid_attempt(value):
    return type(value) is str and ATTEMPT_ID.fullmatch(value) is not None


def present(path):
    return path.exists() or path.is_symlink()


def retry_history(folder):
    """Read under the same lock as launchctl; fail closed on torn reservations."""
    history = folder / "attempts"
    if not present(history):
        return history, []
    private(history, True)
    ledger = history / "current.json"
    require(present(ledger), "MAC_RETRY_HISTORY_INVALID")
    try:
        ledger_data = json.loads(private(ledger).read_bytes())
    except (UnicodeError, ValueError):
        raise Refused("MAC_RETRY_HISTORY_INVALID") from None
    require(type(ledger_data) is dict and set(ledger_data) == {"attemptIds"},
            "MAC_RETRY_HISTORY_INVALID")
    ids = ledger_data["attemptIds"]
    require(type(ids) is list and ids and all(valid_attempt(value) for value in ids)
            and len(set(ids)) == len(ids)
            and set(p.name for p in history.iterdir()) == {"current.json", *ids},
            "MAC_RETRY_HISTORY_INVALID")
    for value in ids:
        private(history / value, True)
    return history, ids


def is_verified_rollback(receipt, legacy):
    if legacy and receipt == {"state": "rolled-back"}:
        return True
    if (type(receipt) is not dict or set(receipt) != {"state", "failure"}
            or receipt["state"] != "rolled-back"):
        return False
    failure = receipt["failure"]
    return (type(failure) is dict and set(failure) == {"stage", "code"}
            and type(failure["stage"]) is str and failure["stage"] in PHASE_CODES
            and type(failure["code"]) is str and failure["code"] in KNOWN_CODES | set(PHASE_CODES.values()))


def authorize_retry(folder, attempt, previous, prior):
    history, ids = retry_history(folder)
    require(attempt not in ids, "MAC_RETRY_ATTEMPT_EXISTS")
    latest = ids[-1] if ids else "initial"
    require(previous == latest, "MAC_RETRY_PARENT_DRIFT")
    previous_folder = history / latest if ids else folder
    previous_status = previous_folder / "result.json"
    require(present(previous_status), "MAC_RETRY_ROLLBACK_REQUIRED")
    try:
        receipt = json.loads(private(previous_status).read_bytes())
    except (UnicodeError, ValueError):
        raise Refused("MAC_RETRY_ROLLBACK_REQUIRED") from None
    require(is_verified_rollback(receipt, legacy=not ids), "MAC_RETRY_ROLLBACK_REQUIRED")
    previous_prior = previous_folder / "prior.plist"
    require(present(previous_prior) and private(previous_prior).read_bytes() == prior,
            "MAC_RETRY_PRIOR_DRIFT")
    return history, ids


def reserve_retry(history, ids, attempt):
    if not ids:
        history.mkdir(mode=0o700)
        sync_directory(history.parent)
    attempt_folder = history / attempt
    attempt_folder.mkdir(mode=0o700)
    # A crash anywhere before result.json leaves an incomplete latest attempt,
    # or an orphan detected by retry_history. Neither permits another retry.
    ledger = history / "current.json"
    atom(ledger, (json.dumps({"attemptIds": [*ids, attempt]}, separators=(",", ":")) + "\n").encode(),
         create=not ids)
    return attempt_folder


def wait_for_old_ports(host, old_pid, *, wait=10, interval=0.25, foreign_code="OLD_NATIVE_PORTS_BUSY"):
    """Wait only for the previously verified NGS listener, never for another owner."""
    deadline = time.monotonic() + wait
    while True:
        listeners = host.listener(5274) | host.listener(5275)
        if not listeners:
            return
        require(listeners == {old_pid}, foreign_code)
        remaining = deadline - time.monotonic()
        require(remaining > 0, "OLD_NATIVE_PORTS_BUSY")
        time.sleep(min(interval, remaining))


def apply(sha, control, host, attempt=None, previous=None):
    stage = "validate_candidate"
    fd = None
    try:
        require(type(sha) is str and SHA.fullmatch(sha), "INVALID_RELEASE_SHA")
        retry = attempt is not None or previous is not None
        require(not retry or valid_attempt(attempt) and (previous == "initial" or valid_attempt(previous)),
                "MAC_RETRY_ID_INVALID")
        private(control, True)
        # Lock before validating the archived candidate and reading attempt history.
        stage = "check_current"
        fd = os.open(control, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        stage = "validate_candidate"
        folder, spec, release, workdir = load_plan(sha, control, host.releases, host.scratch)
        stage = "check_current"
        prior = host.read_plist()
        enable_separation = approve_audio_separation(folder, spec, release)
        old, new, env, migrating = select(prior, release, workdir, host.releases, host.scratch, host.queue, sha,
                                           enable_audio_separation=enable_separation)
        if not retry:
            require(not any(present(folder / name) for name in ("prior.plist", "result.json", "attempts")),
                    "RELEASE_ALREADY_ATTEMPTED_RECONCILE")
        require(old != release and digest(prior) == spec["expectedPriorPlistSha256"], "PRIOR_RELEASE_DRIFT")
        if retry:
            history, ids = authorize_retry(folder, attempt, previous, prior)
        pins = host.unchanged(env)
        pid = host.healthy(old, wait=0)
        if migrating:
            audio_db = host.audio_db_file(env)
            states = audio_states(release)
        stage = "record_result"
        attempt_folder = reserve_retry(history, ids, attempt) if retry else folder
        armed = attempt_folder / "prior.plist"
        status = attempt_folder / "result.json"
        atom(armed, prior, create=True)
        advanced = False
        stopped = False
        try:
            stage = "stop_current"
            host.bootout()
            stopped = True
            stage = "wait_ports"
            wait_for_old_ports(host, pid)
            if migrating:
                stage = "preflight_audio_schema"
                host.audio_storage(env, audio_db, pid, states)
            stage = "switch_selector"
            host.replace(prior, new)
            advanced = True
            stage = "start_candidate"
            host.bootstrap()
            stage = "check_candidate"
            host.healthy(release, old_pid=pid)
            stage = "check_storage"
            require(host.read_plist() == new and host.unchanged(env) == pins, "NATIVE_STORAGE_IDENTITY_DRIFT")
            stage = "record_result"
            receipt = {"sha": sha, "target": "mac", "state": "deployed", "health": "verified"}
            private_receipt = {**receipt, "deployedAt": datetime.now(UTC).isoformat(timespec="seconds").replace("+00:00", "Z")}
            atom(status, (json.dumps(private_receipt) + "\n").encode(), create=True)
            return receipt
        except Exception as error:
            failure = diagnostic(stage, error)
            result = {"state": "rolled-back", "failure": failure}
            try:
                # Commands can fail after taking effect: always inspect actual selected bytes.
                stage = "rollback_restore"
                actual = host.read_plist()
                if actual == new:
                    stage = "rollback_stop"
                    candidate_pid = host.pid() if migrating else None
                    host.stop_if_loaded()
                    if migrating:
                        stage = "rollback_audio_schema"
                        require(host.unchanged(env) == pins, "ROLLBACK_STORAGE_IDENTITY_DRIFT")
                        host.audio_storage(env, audio_db, candidate_pid, states, undo=True)
                    stage = "rollback_restore"
                    host.replace(new, prior)
                    stopped = True
                else:
                    require(actual == prior and not advanced, "ROLLBACK_SELECTOR_DRIFT")
                    stopped = stopped or not host.pid()
                if stopped:
                    stage = "rollback_stop"
                    host.stop_if_loaded()
                    if failure["stage"] in {"wait_ports", "preflight_audio_schema"} and actual == prior and not advanced:
                        # bootout can return before the verified prior listener
                        # exits. Do not bootstrap into either occupied port.
                        wait_for_old_ports(host, pid, foreign_code="NATIVE_PORT_OWNER_DRIFT")
                        if failure["stage"] == "preflight_audio_schema":
                            stage = "rollback_audio_schema"
                            host.audio_storage(env, audio_db, pid, states)
                    stage = "rollback_start"
                    host.bootstrap()
                stage = "rollback_check"
                host.healthy(old)
                require(host.read_plist() == prior and host.unchanged(env) == pins, "ROLLBACK_STORAGE_IDENTITY_DRIFT")
            except Exception as rollback_error:
                result.update(state="rollback-failed", rollbackFailure=diagnostic(stage, rollback_error))
            try:
                atom(status, (json.dumps(result, separators=(",", ":")) + "\n").encode(), create=True)
            except Exception:
                # If the receipt is unwritable, stderr still carries the original phase and safe cause.
                pass
            raise ApplyFailed(failure, result["state"]) from None
    except ApplyFailed:
        raise
    except Exception as error:
        raise ApplyFailed(diagnostic(stage, error)) from None
    finally:
        if fd is not None:
            os.close(fd)


def main():
    def interrupt(_sig, _frame):
        # Once inside a transaction, let the context verify rollback on first stop.
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        raise Refused("MAC_RELEASE_INTERRUPTED")
    signal.signal(signal.SIGTERM, interrupt)
    require(len(sys.argv) >= 2 and SHA.fullmatch(sys.argv[1]), "INVALID_RELEASE_SHA")
    require(len(sys.argv) in (2, 4), "MAC_RETRY_ID_INVALID")
    print(json.dumps(apply(sys.argv[1], CONTROL, Mac(), *sys.argv[2:]),
                     separators=(",", ":")), flush=True)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        # No paths, child stdout, queue content, or auth in OPS logs.
        print(json.dumps(error_record(exc), separators=(",", ":")), file=sys.stderr)
        sys.exit(1)
