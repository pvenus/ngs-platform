def known_reason(error, allowed):
    code = error.args[0] if type(error) is Refused and len(error.args) == 1 else None
    return code if type(code) is str and code in allowed else None


def diagnostic(stage, error):
    code = known_reason(error, KNOWN_CODES)
    if stage == "check_current" and isinstance(error, BlockingIOError):
        code = "MAC_DEPLOY_LOCK_BUSY"
    return {"stage": stage, "code": code or PHASE_CODES[stage]}


class ApplyFailed(Refused):
    def __init__(self, failure, state=None):
        self.failure = failure
        super().__init__({
            "rolled-back": "MAC_APPLY_FAILED_ROLLBACK_VERIFIED",
            "rollback-failed": "MAC_ROLLBACK_UNVERIFIED",
        }.get(state, failure["code"]))


